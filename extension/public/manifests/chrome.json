{
    "manifest_version": 3,
    "name": "TapHTML",
    "version": "1.0.5",
    "description": "TapHTML Extension to manage chats and messages.",
    "permissions": [
        "sidePanel"
    ],
    "host_permissions": [
        "https://api.taphtml.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "action": {
        "default_icon": "icon.png"
    },
    "icons": {
        "128": "icon.png"
    }
}